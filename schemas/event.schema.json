{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFX532 Event",
  "type": "object",
  "required": ["video_id", "start_sec", "end_sec", "evidence_status"],
  "properties": {
    "video_id": {"type": "integer"},
    "start_sec": {"type": "number", "minimum": 0},
    "end_sec": {"type": "number", "minimum": 0},
    "actor": {"type": ["string", "null"]},
    "action_vi": {"type": ["string", "null"]},
    "action_en": {"type": ["string", "null"]},
    "motion_phase": {"type": ["string", "null"]},
    "material": {"type": ["string", "null"]},
    "emotion": {"type": ["string", "null"]},
    "sound_role": {"type": ["string", "null"]},
    "heard_description": {"type": ["string", "null"]},
    "creative_suggestion": {"type": ["string", "null"]},
    "keywords_vi": {"type": ["string", "null"]},
    "keywords_en": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_status": {"type": "string"}
  }
}
